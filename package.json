{
  "name": "pedidoflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db/check.mjs",
    "db:reset:local": "node scripts/db/local.mjs reset",
    "db:migrate:local": "node scripts/db/local.mjs migrate",
    "db:seed:local": "node scripts/db/local.mjs seed",
    "db:inspect:local": "node scripts/db/local.mjs inspect",
    "test:db": "vitest run worker/db/database.test.ts",
    "test:auth": "vitest run worker/auth.test.ts",
    "test:authz": "vitest run worker/authorization.test.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "1.6.26",
    "drizzle-orm": "0.45.2",
    "hono": "^4.10.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.7",
    "@types/node": "^24.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "drizzle-kit": "0.31.10",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.131.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260910.1": true,
    "fsevents@2.3.3": true
  }
}
